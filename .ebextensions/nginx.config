files:
  "/etc/nginx/conf.d/custom.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      server {
        listen 80;
        
        location / {
          root /var/app/current/dist;
          index index.html;
          try_files $uri $uri/ /index.html;
        }
        
        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg)$ {
          root /var/app/current/dist;
          expires 1y;
          add_header Cache-Control "public, immutable";
        }
      }
